# 下项只控制旧演示；真实 RecipeGen /api/search 等接口始终读取 Neo4j。
# 真实系统启动与 GraphRAG 索引见 README.md 和 docs/GraphRAG设计.md。
RECIPEGEN_GRAPH_BACKEND=sqlite
# RECIPEGEN_DB_PATH=var/recipegen.sqlite3
RECIPEGEN_LLM_PROVIDER=disabled
# chat_completions: BASE_URL 应以 /v1 等兼容接口前缀结尾，不包含 /chat/completions。
# ollama: BASE_URL 为 http://127.0.0.1:11434，不包含 /api/chat。
RECIPEGEN_LLM_BASE_URL=
RECIPEGEN_LLM_MODEL=
RECIPEGEN_LLM_API_KEY=
RECIPEGEN_LLM_TIMEOUT=30
RECIPEGEN_CONTEXT_CANDIDATES=12
# 真实系统默认 hybrid：关键词 + 本地 E5 语义召回 + Neo4j 关系扩展。
# 仅准备文本索引，无需 LLM API；稍后把 PROVIDER 改为 chat_completions 并填上现有字段。
RECIPEGEN_RETRIEVAL_MODE=hybrid
# RECIPEGEN_TRACE_PATH=var/traces.jsonl
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
