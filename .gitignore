# Local credentials: only the root template belongs in Git.
.env*
!/.env.example
.runtime/
.venv*/
.venvs/
venv/
node_modules/
__pycache__/
.pytest_cache/
*.py[cod]
*.egg-info/
.DS_Store
*.log
*.part
var/

# Only these hand-written examples are distributed. All rebuilt graph data,
# vectors, source records and multimodal checkpoints stay on the local machine.
/data/*
!/data/README.md
!/data/example_graph.json
!/data/evaluation_cases.json
/reports/*
!/reports/发布验收.md

